{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/orchestrator/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/orchestrator/approvals.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
